# Fresh installs use SINet database names. Existing volumes: see docs/OPERATIONS.md.
POSTGRES_USER=sinet
POSTGRES_DB=sinet
APP_ENV=development
APP_HTTP_ADDR=127.0.0.1:8080
APP_PUBLIC_URL=http://127.0.0.1:8080
DATABASE_URL=postgres://sinet:local-development-only@127.0.0.1:5432/sinet?sslmode=disable
SMTP_ADDR=127.0.0.1:1025
SMTP_FROM=no-reply@sinet.example
# Production SMTP always requires STARTTLS. Optional credentials:
SMTP_USERNAME=
SMTP_PASSWORD=
# Required in production: at least 32 random characters; keep outside source.
OTP_HASH_KEY=
# Set all three to enable real model chat; chat explicitly sends text to this provider.
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# CLI session file is stored with mode 0600. Override for separate profiles:
# SINET_CONFIG=./work/alice.json
SINET_API=http://127.0.0.1:8080
