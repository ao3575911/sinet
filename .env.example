APP_ENV=development
APP_HTTP_ADDR=127.0.0.1:8080
APP_PUBLIC_URL=http://127.0.0.1:8080
DATABASE_URL=postgres://projectname:local-development-only@127.0.0.1:5432/projectname?sslmode=disable
SMTP_ADDR=127.0.0.1:1025
SMTP_FROM=no-reply@project-name.example
# Production SMTP always requires STARTTLS. Optional credentials:
SMTP_USERNAME=
SMTP_PASSWORD=
# Set all three to enable real model chat; chat explicitly sends text to this provider.
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# CLI session file is stored with mode 0600. Override for separate profiles:
# PROJECT_NAME_CONFIG=./work/alice.json
PROJECT_NAME_API=http://127.0.0.1:8080
