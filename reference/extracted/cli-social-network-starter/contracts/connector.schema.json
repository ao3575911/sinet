{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project-name Connector Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "publisher",
    "name",
    "description",
    "runtime",
    "operations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,62}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "publisher": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 280
    },
    "runtime": {
      "enum": [
        "builtin",
        "remote_https"
      ]
    },
    "privacy_policy_url": {
      "type": "string",
      "format": "uri"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "risk",
          "parameters"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "description": {
            "type": "string",
            "maxLength": 280
          },
          "risk": {
            "enum": [
              "read",
              "write",
              "external_disclosure"
            ]
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    },
    "endpoint_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "remote_https"
          }
        },
        "required": [
          "runtime"
        ]
      },
      "then": {
        "required": [
          "endpoint_url"
        ]
      }
    }
  ]
}
