{
  "id": "echo",
  "version": "1.0.0",
  "publisher": "SINet",
  "name": "Echo",
  "description": "Returns the text you provide. No network or data export.",
  "runtime": "builtin",
  "operations": [
    {
      "name": "repeat",
      "description": "Return the supplied text",
      "risk": "read",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": [
          "text"
        ]
      }
    }
  ]
}
